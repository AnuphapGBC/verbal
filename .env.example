DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional direct connection for migrations; otherwise the pooler suffix is removed.
DIRECT_DATABASE_URL=
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain.example when deploying.
# PORT is also used by the production server, which serves dist/ and /api together.

# Optional Gmail notifications. Never use your normal Google sign-in password.
# Store the Google app password as a Production Secret in Vercel, without VITE_.
SMTP_USER=verbal.notifications@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Verbal Notifications
MAIL_ENABLED=false
